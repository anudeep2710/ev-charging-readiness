	partition Geography = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ProjectRoot & "\data\processed\state_summary.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Headers, {"state_abbr", "state_name", "population_2025", "total_stations", "available_stations", "public_available_stations", "public_available_per_100k", "priority_score", "priority_band", "national_median_public_available_per_100k"}),
