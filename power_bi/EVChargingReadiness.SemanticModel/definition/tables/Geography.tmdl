					Typed = Table.TransformColumnTypes(Nulls, {{"state_abbr", type text}, {"state_name", type text}, {"population_2025", Int64.Type}, {"total_stations", Int64.Type}, {"available_stations", Int64.Type}, {"public_available_stations", Int64.Type}, {"public_available_per_100k", type number}, {"priority_score", type number}, {"priority_band", type text}, {"national_median_public_available_per_100k", type number}}, "en-US")
				in
					Typed
