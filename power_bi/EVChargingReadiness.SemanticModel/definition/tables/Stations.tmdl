		sourceColumn: total_ports

	column dc_fast_ports
		dataType: double
		lineageTag: 6259fc96-889e-4b99-810a-7b69cfacc4f9
		summarizeBy: none
		sourceColumn: dc_fast_ports

	column is_public
		dataType: boolean
		lineageTag: 6ed45524-1d11-49cf-a82d-405b8227355f
		summarizeBy: none
		sourceColumn: is_public

	column is_available
		dataType: boolean
		lineageTag: 9301fb0e-68eb-4253-904e-db6468242486
		summarizeBy: none
		sourceColumn: is_available

	column is_public_available
		dataType: boolean
		lineageTag: 4e12c065-5f02-444e-a7f6-dcb2c10d884d
		summarizeBy: none
		sourceColumn: is_public_available

	column has_dc_fast
		dataType: boolean
		lineageTag: dee8e5af-3eec-4f83-a17e-ee44e5bc5054
		summarizeBy: none
		sourceColumn: has_dc_fast

	column readiness_score
		dataType: int64
		lineageTag: 83bc7050-aeca-4ee5-a131-acb2ecdffd7a
		summarizeBy: none
		sourceColumn: readiness_score

	column readiness_band
		dataType: string
		lineageTag: a9742921-1281-4421-86cc-83d482503237
		summarizeBy: none
		sourceColumn: readiness_band

	column open_year
		dataType: int64
		lineageTag: 33dd0822-b214-4a5f-9c09-89fd90f54b71
		summarizeBy: none
		sourceColumn: open_year

	partition Stations = m
		mode: import
		source =
				let
					Source = Csv.Document(File.Contents(ProjectRoot & "\data\processed\ev_stations_clean.csv"), [Delimiter=",", Encoding=65001, QuoteStyle=QuoteStyle.Csv]),
					Headers = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
					Selected = Table.SelectColumns(Headers, {"station_id", "state_abbr", "station_name", "city", "access_label", "status_label", "facility_type_label", "ev_network", "total_ports", "dc_fast_ports", "is_public", "is_available", "is_public_available", "has_dc_fast", "readiness_score", "readiness_band", "open_year"}),
					Nulls = Table.ReplaceValue(Selected, "", null, Replacer.ReplaceValue, Table.ColumnNames(Selected)),
					Typed = Table.TransformColumnTypes(Nulls, {{"station_id", Int64.Type}, {"state_abbr", type text}, {"station_name", type text}, {"city", type text}, {"access_label", type text}, {"status_label", type text}, {"facility_type_label", type text}, {"ev_network", type text}, {"total_ports", type number}, {"dc_fast_ports", type number}, {"is_public", type logical}, {"is_available", type logical}, {"is_public_available", type logical}, {"has_dc_fast", type logical}, {"readiness_score", Int64.Type}, {"readiness_band", type text}, {"open_year", Int64.Type}}, "en-US")
				in
					Typed
